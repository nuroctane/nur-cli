{
  "description": "A fuzzy edit starting with a multibyte character applies without panicking.",
  "prompt": "Replace the quoted greeting in note.txt.",
  "setup_files": {"note.txt": "é“hello”\n"},
  "script": [
    {"tool_calls": [{"name": "read_file", "arguments": {"path": "note.txt"}}]},
    {"tool_calls": [{"name": "edit_file", "arguments": {"path": "note.txt", "old_string": "é\"hello\"", "new_string": "done"}}]},
    {"text": "Greeting replaced."}
  ],
  "expect": {
    "exit_code": 0,
    "requests": 3,
    "files": {"note.txt": "done\n"},
    "stdout_contains": ["Greeting replaced."]
  }
}

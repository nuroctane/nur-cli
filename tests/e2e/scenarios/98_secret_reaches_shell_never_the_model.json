{
  "description": "A saved secret is set in shell commands as an environment variable, but every tool result the model receives shows [secret:NAME] instead of the value, and the system prompt names the secret without its value.",
  "prompt": "Check the deploy token works.",
  "setup_home_files": {
    "secrets.json": "{\"secrets\": {\"DEMO_TOKEN\": {\"value\": \"s3cret-Value-XYZ987\", \"added_at\": \"2026-10-30T00:00:00Z\"}}}\n"
  },
  "script": [
    {
      "tool_calls": [
        {
          "name": "bash",
          "arguments": {
            "command": "python -c \"import os; print('token=' + os.environ['DEMO_TOKEN'])\""
          }
        }
      ]
    },
    { "text": "The token is set." }
  ],
  "expect": {
    "exit_code": 0,
    "requests": 2,
    "stdout_contains": ["The token is set."],
    "stdout_lacks": ["s3cret-Value-XYZ987"],
    "requests_contain": ["$DEMO_TOKEN"],
    "requests_lack": ["s3cret-Value-XYZ987"],
    "tool_results": [
      { "request": 2, "contains": ["token=[secret:DEMO_TOKEN]"] }
    ]
  }
}

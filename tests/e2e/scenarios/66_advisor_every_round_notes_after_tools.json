{
  "description": "[advisor] every_round = true: after a tool round the advisor's note is placed after the tool result, the agent reads it on its next step, and an advisor NONE before the end lets the turn finish.",
  "prompt": "What does notes.txt say?",
  "setup_files": {
    "notes.txt": "ship on friday\n"
  },
  "setup_home_files": {
    "config.toml": "provider = \"vllm\"\nbase_url = \"http://127.0.0.1:{port}/v1\"\nmodel = \"e2e-model\"\n[advisor]\nmodel = \"advisor-model\"\nevery_round = true\n"
  },
  "script": [
    {
      "tool_calls": [
        {
          "name": "read_file",
          "arguments": {
            "path": "notes.txt"
          }
        }
      ]
    },
    {
      "text": "Quote the file exactly."
    },
    {
      "text": "It says: ship on friday"
    },
    {
      "text": "NONE"
    }
  ],
  "expect": {
    "exit_code": 0,
    "requests": 4,
    "stdout_contains": [
      "It says: ship on friday"
    ],
    "stdout_lacks": [
      "NONE"
    ],
    "request_contains": [
      {
        "request": 2,
        "contains": [
          "\"model\": \"advisor-model\"",
          "ship on friday",
          "mid-turn"
        ]
      },
      {
        "request": 3,
        "contains": [
          "[nur advisor · advisor-model] Quote the file exactly."
        ]
      },
      {
        "request": 4,
        "contains": [
          "\"model\": \"advisor-model\"",
          "about to end its turn"
        ]
      }
    ]
  }
}

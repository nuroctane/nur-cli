{
  "description": "Credentials already used by a session stay redacted when another process rotates the store.",
  "prompt": "Call hello and read the diagnostic file.",
  "setup_files": {
    "diagnostic.txt": "old=old-access-token\nold_refresh=old-refresh-token\nnew=new-access-token\nnew_refresh=new-refresh-token\n"
  },
  "setup_home_files": {
    "config.toml": "provider = \"vllm\"\nbase_url = \"http://127.0.0.1:{port}/v1\"\nmodel = \"e2e-model\"\n[mcp.servers.fake]\nurl = \"http://127.0.0.1:{port}/mcp\"\nread_only = true\n"
  },
  "mcp": {
    "key": "old-access-token",
    "rotate_store_on_call": {
      "server": "fake",
      "access_token": "new-access-token",
      "refresh_token": "new-refresh-token"
    },
    "tools": [
      {
        "name": "hello",
        "inputSchema": {
          "type": "object"
        }
      }
    ],
    "results": {
      "hello": {
        "content": [
          {
            "type": "text",
            "text": "hello"
          }
        ]
      }
    }
  },
  "script": [
    {
      "tool_calls": [
        {
          "name": "mcp",
          "arguments": {
            "action": "call",
            "server": "fake",
            "tool": "hello",
            "arguments": {}
          }
        }
      ],
      "write_mcp_store": {
        "fake": {
          "resource": "http://127.0.0.1:{port}/mcp",
          "access_token": "old-access-token",
          "refresh_token": "old-refresh-token",
          "expires_at": 4102444800
        }
      }
    },
    {
      "tool_calls": [
        {
          "name": "read_file",
          "arguments": {
            "path": "diagnostic.txt"
          }
        }
      ]
    },
    {
      "text": "Rotation checked."
    }
  ],
  "expect": {
    "exit_code": 0,
    "requests": 3,
    "stdout_contains": [
      "Rotation checked."
    ],
    "tool_results": [
      {
        "request": 3,
        "contains": [
          "[secret:MCP_TOKEN]"
        ],
        "lacks": [
          "old-access-token",
          "old-refresh-token",
          "new-access-token",
          "new-refresh-token"
        ]
      }
    ]
  }
}

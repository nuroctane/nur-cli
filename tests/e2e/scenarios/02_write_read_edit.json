{
  "description": "write_file, read_file and edit_file change the real workspace, and each result is fed back to the model.",
  "prompt": "Create notes.txt, read it back, then change beta to gamma.",
  "script": [
    {"tool_calls": [{"name": "write_file", "arguments": {"path": "notes.txt", "contents": "alpha\nbeta\n"}}]},
    {"tool_calls": [{"name": "read_file", "arguments": {"path": "notes.txt"}}]},
    {"tool_calls": [{"name": "edit_file", "arguments": {"path": "notes.txt", "old_string": "beta", "new_string": "gamma"}}]},
    {"text": "Edited notes.txt."}
  ],
  "expect": {
    "files": {"notes.txt": {"contains": ["alpha", "gamma"], "lacks": ["beta"]}},
    "tool_results": [{"request": 3, "contains": ["beta"]}],
    "stdout_contains": ["Edited notes.txt."],
    "requests": 4
  }
}

{
  "description": "Overlapping secret values are replaced as whole values, without leaking a suffix or rewriting the redaction markers.",
  "prompt": "Check both saved credentials.",
  "setup_home_files": {
    "secrets.json": "{\"secrets\":{\"A_SHORT\":{\"value\":\"secret\",\"added_at\":\"2026-10-30T00:00:00Z\"},\"Z_LONG\":{\"value\":\"secret-long-credential\",\"added_at\":\"2026-10-30T00:00:00Z\"}}}"
  },
  "script": [
    {
      "tool_calls": [
        {
          "name": "bash",
          "arguments": {
            "command": "python -c \"import os; print(os.environ['Z_LONG'], os.environ['A_SHORT'])\""
          }
        }
      ]
    },
    { "text": "Both credentials checked." }
  ],
  "expect": {
    "exit_code": 0,
    "requests": 2,
    "stdout_lacks": ["-long-credential"],
    "requests_lack": ["-long-credential"],
    "tool_results": [
      { "request": 2, "contains": ["[secret:Z_LONG] [secret:A_SHORT]"] }
    ]
  }
}

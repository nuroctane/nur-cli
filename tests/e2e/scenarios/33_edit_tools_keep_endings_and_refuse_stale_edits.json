{
  "description": "apply_patch keeps a CRLF file CRLF and inserts a zero-count hunk after the named line; multi_edit refuses an empty old_string and writes nothing; an edit against a file changed since the last read is refused until it is read again.",
  "prompt": "Patch config.ini, fix notes.txt, then update greeting.txt.",
  "setup_files": {
    "config.ini": "[core]\r\nname = nur\r\nverbose = false\r\n",
    "notes.txt": "alpha\nbeta\n",
    "greeting.txt": "hello world\n"
  },
  "script": [
    {"tool_calls": [{"name": "apply_patch", "arguments": {"path": "config.ini", "patch": "@@ -1,0 +2,1 @@\n+; generated\n@@ -3,1 +4,1 @@\n-verbose = false\n+verbose = true\n"}}]},
    {"tool_calls": [{"name": "multi_edit", "arguments": {"path": "notes.txt", "edits": [{"old_string": "alpha", "new_string": "ALPHA"}, {"old_string": "", "new_string": "oops"}]}}]},
    {"tool_calls": [{"name": "read_file", "arguments": {"path": "greeting.txt"}}]},
    {"tool_calls": [{"name": "bash", "arguments": {"command": "python -c \"open('greeting.txt','wb').write(b'hello there\\n')\"", "timeout_ms": 20000}}]},
    {"tool_calls": [{"name": "edit_file", "arguments": {"path": "greeting.txt", "old_string": "hello", "new_string": "goodbye"}}]},
    {"tool_calls": [{"name": "read_file", "arguments": {"path": "greeting.txt"}}]},
    {"tool_calls": [{"name": "edit_file", "arguments": {"path": "greeting.txt", "old_string": "hello", "new_string": "goodbye"}}]},
    {"text": "All edits done."}
  ],
  "expect": {
    "files": {
      "config.ini": "[core]\r\n; generated\r\nname = nur\r\nverbose = true\r\n",
      "notes.txt": "alpha\nbeta\n",
      "greeting.txt": "goodbye there\n"
    },
    "tool_results": [
      {"request": 2, "contains": ["patched config.ini"]},
      {"request": 3, "contains": ["edits[1]: old_string must not be empty", "no edits in this call were written"]},
      {"request": 6, "contains": ["changed since you last read it"]},
      {"request": 8, "contains": ["edited"]}
    ],
    "stdout_contains": ["All edits done."],
    "requests": 8
  }
}

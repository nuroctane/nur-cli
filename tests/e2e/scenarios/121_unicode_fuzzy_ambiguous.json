  "setup_files": {"note.txt": "é“hello”\né“hello”\n"},
  "script": [
    {"tool_calls": [{"name": "read_file", "arguments": {"path": "note.txt"}}]},
    {"tool_calls": [{"name": "edit_file", "arguments": {"path": "note.txt", "old_string": "é\"hello\"", "new_string": "done"}}]},

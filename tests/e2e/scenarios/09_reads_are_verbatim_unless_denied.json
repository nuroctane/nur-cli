{
  "description": "An allowed file is read, while a permissions.toml deny rule blocks a separate file even for a read-only tool.",
  "prompt": "Read both env files.",
  "setup_files": {
    ".env": "OPENAI_API_KEY=sk-e2etestsecret0123456789abcdefghijklmnop\n",
    "prod.env": "DATABASE_URL=postgres://deploy:prod-only-secret-7731@db.internal/app\n"
  },
  "setup_home_files": {
    "permissions.toml": "deny = [\"read_file:*prod.env\"]\n"
  },
  "script": [
    {"tool_calls": [{"name": "read_file", "arguments": {"path": ".env"}}]},
    {"tool_calls": [{"name": "read_file", "arguments": {"path": "prod.env"}}]},
    {"text": "Read the allowed file; the other is denied."}
  ],
  "expect": {
    "stdout_contains": ["Read the allowed file; the other is denied."],
    "requests": 3,
    "tool_results": [
      {"request": 2, "contains": ["OPENAI_API_KEY=sk-e2etestsecret0123456789abcdefghijklmnop"]},
      {"request": 3, "contains": ["permissions.toml"]}
    ],
    "requests_lack": ["prod-only-secret-7731"]
  }
}

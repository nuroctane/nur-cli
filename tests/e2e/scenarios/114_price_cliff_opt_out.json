{
  "description": "Users can opt out of price-cliff compaction to use the provider's full context.",
  "provider": "openai-cc",
  "model": "gpt-5.6",
  "env": {
    "OPENAI_API_KEY": "e2e-isolated-key"
  },
  "setup_home_files": {
    "config.toml": "provider=\"openai-cc\"\nbase_url=\"http://127.0.0.1:{port}/v1\"\nmodel=\"gpt-5.6\"\ncontext_window=1000000\navoid_long_context_pricing=false\nnative_memory=false\n[typesafe]\nenabled=false\n"
  },
  "prompt": "Inspect the workspace and continue.",
  "script": [
    {
      "tool_calls": [
        {
          "name": "list_dir",
          "arguments": {
            "path": "."
          }
        }
      ],
      "usage": {
        "prompt_tokens": 280000,
        "completion_tokens": 5,
        "total_tokens": 280005
      }
    },
    {
      "text": "Continued with full context."
    }
  ],
  "expect": {
    "exit_code": 0,
    "requests": 2,
    "stdout_contains": [
      "Continued with full context."
    ],
    "request_contains": [
      {
        "request": 2,
        "lacks": [
          "Summarize this conversation"
        ]
      }
    ]
  }
}

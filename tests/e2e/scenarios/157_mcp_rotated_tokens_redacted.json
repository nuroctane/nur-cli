{
  "description": "Both old and newly rotated MCP credentials stay out of subsequent tool results.",
  "prompt": "Call hello and read the diagnostic file.",
  "setup_files": {"diagnostic.txt": "old=rejected-access\nold_refresh=old-refresh\nnew=fresh-access\nnew_refresh=rotated-refresh\n"},
  "setup_home_files": {
    "config.toml": "provider = \"vllm\"\nbase_url = \"http://127.0.0.1:{port}/v1\"\nmodel = \"e2e-model\"\n[mcp.servers.fake]\nurl = \"http://127.0.0.1:{port}/mcp\"\nread_only = true\n",
    "mcp-tokens.json": "{\"fake\":{\"resource\":\"http://127.0.0.1:{port}/mcp\",\"access_token\":\"rejected-access\",\"refresh_token\":\"old-refresh\",\"client_id\":\"test-client\",\"token_endpoint\":\"http://127.0.0.1:{port}/mcp-token\",\"expires_at\":4102444800}}"
  },
  "mcp": {
    "key": "fresh-access", "refresh": {"token": "old-refresh", "client_id": "test-client"},
    "tools": [{"name": "hello", "inputSchema": {"type": "object"}}],
    "results": {"hello": {"content": [{"type": "text", "text": "hello"}]}}
  },
  "script": [
    {"tool_calls": [{"name": "mcp", "arguments": {"action": "call", "server": "fake", "tool": "hello", "arguments": {}}}]},
    {"tool_calls": [{"name": "read_file", "arguments": {"path": "diagnostic.txt"}}]},
    {"text": "Diagnostic checked."}
  ],
  "expect": {
    "exit_code": 0,
    "requests": 3,
    "stdout_contains": ["Diagnostic checked."],
    "tool_results": [{"request": 3, "contains": ["[secret:MCP_TOKEN]"], "lacks": ["rejected-access", "old-refresh", "fresh-access", "rotated-refresh"]}]
  }
}

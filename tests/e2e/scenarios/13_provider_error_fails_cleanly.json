      "error": "scripted upstream outage"
    },
    {
      "status": 500,
      "error": "scripted upstream outage"
    },
    {
      "status": 500,
      "error": "scripted upstream outage"
    },
    {
      "status": 500,
      "error": "scripted upstream outage"
    },
    {
      "status": 500,
      "error": "scripted upstream outage"
    }
  ],
  "expect": {
    "exit_code": 4,
    "stderr_contains": [
      "scripted upstream outage"
    ]
  },
  "setup_home_files": {
    "config.toml": "provider = \"vllm\"\nbase_url = \"http://127.0.0.1:{port}/v1\"\nmodel = \"e2e-model\"\n[auto_continue]\nenabled = false\n"
  }
